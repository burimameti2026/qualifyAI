{
  "ReverseProxy": {
    "Routes": {
      "identity-token": {
        "ClusterId": "identity",
        "Match": { "Path": "/connect/{**catch-all}" }
      },
      "identity-api": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "automation-module": {
        "ClusterId": "platform",
        "Match": { "Path": "/services/automation/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/services/automation" },
          { "PathPrefix": "/api/modules/automation" }
        ]
      },
      "notifications-module": {
        "ClusterId": "platform",
        "Match": { "Path": "/services/notifications/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/services/notifications" },
          { "PathPrefix": "/api/modules/notifications" }
        ]
      },
      "knowledge-module": {
        "ClusterId": "platform",
        "Match": { "Path": "/services/knowledge/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/services/knowledge" },
          { "PathPrefix": "/api/modules/knowledge" }
        ]
      },
      "ai-module": {
        "ClusterId": "platform",
        "Match": { "Path": "/services/ai/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/services/ai" },
          { "PathPrefix": "/api/modules/ai" }
        ]
      },
      "integrations-module": {
        "ClusterId": "platform",
        "Match": { "Path": "/services/integrations/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/services/integrations" },
          { "PathPrefix": "/api/modules/integrations" }
        ]
      },
      "platform-api": {
        "ClusterId": "platform",
        "Order": 100,
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "platform-hubs": {
        "ClusterId": "platform",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "platform": {
        "Destinations": { "primary": { "Address": "http://platform-api:8080" } }
      },
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity-api:8080" } }
      }
    }
  }
}
