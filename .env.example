# Linux API containers reach Windows SQLEXPRESS through this fixed TCP endpoint.
DB_SERVER=host.docker.internal,1433
DB_USER=your-sql-login
DB_PASSWORD=your-sql-password
MONGO_ROOT_USER=qualifyai
MONGO_ROOT_PASSWORD=QualifyAI_Mongo_ChangeMe!
RABBITMQ_USER=qualifyai
RABBITMQ_PASSWORD=QualifyAI_Rabbit_ChangeMe!
REDIS_PASSWORD=QualifyAI_Redis_ChangeMe!
SEQ_ADMIN_PASSWORD=QualifyAI_Seq_ChangeMe!
DEMO_ADMIN_PASSWORD=Admin123!ChangeMe
OPENAI_API_KEY=

# Online company discovery. Create your own SerpAPI key; it is used only by platform-api.
SERPAPI_API_KEY=

# Email delivery (recommended free provider: Brevo API)
EMAIL_PROVIDER=brevo
OUTREACH_DAILY_SEND_LIMIT=10
BREVO_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
BREVO_API_KEY=

# Optional SMTP fallback. Use a Brevo SMTP key here, never the API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
SENDGRID_INBOUND_WEBHOOK_TOKEN=replace-with-a-second-long-random-webhook-token

# Public landing-page demo requests. The addresses stay server-side, never in browser code.
# Separate up to five internal inboxes with commas. Every recipient receives an individual email.
DEMO_REQUEST_RECIPIENTS=buriameti2001@gmail.com,second-inbox@example.com
# Backwards-compatible single recipient. Leave blank when DEMO_REQUEST_RECIPIENTS is set.
DEMO_REQUEST_RECIPIENT=
DEMO_REQUEST_FROM_EMAIL=
DEMO_REQUEST_FROM_NAME=QualifyAI Product Team
