SQL_SA_PASSWORD=QualifyAI_SQL_ChangeMe123!
DB_SERVER=host.docker.internal,1433
DB_USER=your-local-sql-user
DB_PASSWORD=your-local-sql-password
MONGO_ROOT_USER=qualifyai
MONGO_ROOT_PASSWORD=QualifyAI_Mongo_ChangeMe!
RABBITMQ_USER=qualifyai
RABBITMQ_PASSWORD=QualifyAI_Rabbit_ChangeMe!
REDIS_PASSWORD=QualifyAI_Redis_ChangeMe!
SEQ_ADMIN_PASSWORD=QualifyAI_Seq_ChangeMe!
DEMO_ADMIN_PASSWORD=Admin123!ChangeMe
OPENAI_API_KEY=

# Email delivery (recommended free provider: Brevo API)
EMAIL_PROVIDER=brevo
OUTREACH_DAILY_SEND_LIMIT=10
BREVO_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
BREVO_API_KEY=

# Optional SMTP fallback. Use a Brevo SMTP key here, never the API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=
